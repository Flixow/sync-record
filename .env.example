# SyncRecord collector configuration. Copy to .env (never commit it) or pass the
# variables to the container. Every value below is a placeholder.

# Listen address. Use HOST=0.0.0.0 inside a container.
HOST=127.0.0.1
PORT=8080

# Required. At least 16 random characters. Signs the invite and participant tokens.
# Changing it invalidates every token already handed out.
TOKEN_SIGNING_SECRET=

# Optional. When set, creating a session requires this key (use it on any
# deployment reachable from the internet, because there are no accounts).
SESSION_CREATE_KEY=

# How long invite and participant tokens stay valid, in hours. A participant
# token is renewed whenever the participant opens the session page.
TOKEN_TTL_HOURS=72

# Largest accepted upload request body, in bytes.
MAX_UPLOAD_BYTES=16777216

# Storage backend: local | s3
STORAGE_DRIVER=local

# local driver: directory that holds raw parts and the final files.
STORAGE_LOCAL_DIR=./data

# s3 driver (any S3-compatible service). Leave empty for the local driver.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Required external tools, looked up on PATH unless set here.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Where the built web client lives (default: ./dist/web).
WEB_DIR=

# Post-production (editor). Everything is local.
# POST_DIR defaults to <STORAGE_LOCAL_DIR>/post (./post with the S3 driver).
POST_DIR=
POST_CONCURRENCY=1
POST_NICE=10
POST_THREADS=0
# Jobs are refused below this much free disk.
POST_MIN_FREE_GB=10
# keep-exports: delete proxies after an export | keep-all
POST_RETENTION=keep-exports
LOUDNESS_LUFS=-16
TRUE_PEAK_DBTP=-1
# Speech models are downloaded here on first use (default <POST_DIR>/models).
MODELS_DIR=
# Speech recognition: a Python with faster-whisper installed, and the model (downloaded into MODELS_DIR on first use).
ASR_PYTHON=python3
ASR_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# Optional local OpenAI-compatible LLM (llama.cpp server) for clip re-ranking and titles. Off when empty.
LLM_URL=
LLM_MODEL=
