# SyncRecord collector configuration. Copy to .env (never commit it) or pass the
# variables to the container. Every value below is a placeholder.

# Listen address. Use HOST=0.0.0.0 inside a container.
HOST=127.0.0.1
PORT=8080

# Required. At least 16 random characters. Signs the invite and participant tokens.
# Changing it invalidates every token already handed out.
TOKEN_SIGNING_SECRET=

# Optional. When set, creating a session requires this key (use it on any
# deployment reachable from the internet, because there are no accounts).
SESSION_CREATE_KEY=

# How long invite and participant tokens stay valid, in hours. A participant
# token is renewed whenever the participant opens the session page.
TOKEN_TTL_HOURS=72

# Largest accepted upload request body, in bytes.
MAX_UPLOAD_BYTES=16777216

# Storage backend: local | s3
STORAGE_DRIVER=local

# local driver: directory that holds raw parts and the final files.
STORAGE_LOCAL_DIR=./data

# s3 driver (any S3-compatible service). Leave empty for the local driver.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Required external tools, looked up on PATH unless set here.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Where the built web client lives (default: ./dist/web).
WEB_DIR=

# Post-production (editor). Everything is local.
# POST_DIR defaults to <STORAGE_LOCAL_DIR>/post (./post with the S3 driver).
POST_DIR=
POST_CONCURRENCY=1
POST_NICE=10
POST_THREADS=0
# Jobs are refused below this much free disk.
POST_MIN_FREE_GB=10
# keep-exports: delete proxies after an export | keep-all
POST_RETENTION=keep-exports
LOUDNESS_LUFS=-16
TRUE_PEAK_DBTP=-1
# Speech models are downloaded here on first use (default <POST_DIR>/models).
MODELS_DIR=
# Speech recognition: a Python with faster-whisper installed, and the model (downloaded into MODELS_DIR on first use).
ASR_PYTHON=python3
# Leave ASR_MODEL unset to pick the largest model that fits the container's memory; set it (for example `small`) to pin one.
# ASR_MODEL=
# CTranslate2 compute type on the CPU: int8 | int8_float32 | int16 | float32 | auto
ASR_COMPUTE_TYPE=int8
# Optional language model (clips cut by the model, chapter titles, title/description draft, scene-plan suggestion). Off when LLM_URL
# is empty, except LLM_PROVIDER=anthropic, which is on only when a key is set (it then needs no LLM_URL).
# PRIVACY: with a model on, the transcript TEXT (and its timings; never audio, video or frames) leaves this machine for that service.
# LLM_PROVIDER: openai-compatible (default; llama.cpp, Ollama, LiteLLM, OpenRouter, OpenAI, ...) | omp-gateway (needs a model and a key)
#               | anthropic (Anthropic Messages API, https://api.anthropic.com unless LLM_URL is set; needs a key)
LLM_URL=
LLM_PROVIDER=openai-compatible
# Default for anthropic: claude-opus-5-5 (Opus 5.5; the id is from Anthropic's release notes, not yet confirmed by a request).
LLM_MODEL=
# Key for the endpoint: LLM_API_KEY or LLM_API_KEY_FILE (a path), not both. Keep it out of the repository.
LLM_API_KEY=
LLM_API_KEY_FILE=
# Key of the anthropic provider when neither of the two above is set. Never commit it; prefer LLM_API_KEY_FILE with a secret.
ANTHROPIC_API_KEY=
LLM_TIMEOUT_MS=60000
# Timeout of the one request that cuts clips (the whole transcript goes in and the model may think first), 1000-600000.
SHORTS_TIMEOUT_MS=120000
# Optional telemetry to your own PostHog (see README "Telemetry"). Off unless BOTH are set; keep the key out of the repository.
POSTHOG_KEY=
POSTHOG_HOST=
# Optional conversation in the page on a LiveKit server. Off unless ALL THREE are set. The key and secret are the ones in the LiveKit
# server's config (keys:); keep the secret out of the repository. LIVEKIT_URL is the public wss:// URL without a path.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Lifetime of a call token in seconds (60 to 3600).
LIVEKIT_TOKEN_TTL_SECONDS=600
